# ============================================================
#  NETMED — .gitignore
#  File e cartelle da tenere FUORI dal repository git.
# ============================================================

# ---- Dipendenze ----
# node_modules e' pesante (~26MB) e ricreabile con `npm install`.
# Il resto lo installi da package.json + package-lock.json.
node_modules/

# ---- Segreti ambientali ----
# .env contiene JWT_SECRET, password DB e altri segreti reali.
# NON deve MAI finire su git. Solo il template .env.example va committato.
.env
.env.local
.env.*.local
.env.production
.env.development

# ---- Log ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---- Cache & coverage test ----
coverage/
.nyc_output/
.cache/

# ---- Editor / IDE (impostazioni personali) ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Sistema operativo ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Backup e file temporanei da recovery ----
*.bak
*.orig
*.OLD_DELETE_ME
*.tmp

# ---- Dati Postgres (se Docker monta il volume in locale) ----
pgdata/
postgres-data/

# ---- Upload utente (se salvi file su disco invece di DB) ----
uploads/

# ---- Archivi ----
*.zip
*.tar.gz
*.7z

# ---- Build / dist (non applicabile qui, ma preventivo) ----
dist/
build/
out/
