# NETMED — Variabili d'ambiente di esempio
# Copia in `.env` e personalizza i valori.

# ---------- Database ----------
# Per Docker compose: l'host del DB e' "db" (nome servizio nel compose).
# In locale senza Docker: host = "localhost".
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=netmed

# In alternativa puoi usare DATABASE_URL (prevale su DB_*):
DATABASE_URL=postgresql://postgres:postgres@db:5432/netmed

# Attiva SSL solo per cloud DB (Heroku/Render/Supabase). Per Docker locale: false.
DB_SSL=false

# ---------- App ----------
NODE_ENV=production
PORT=3000
APP_BASE_URL=http://localhost:3000

# Cambia con qualcosa di lungo e casuale in produzione!
JWT_SECRET=change_me_in_production_super_secret_xxxxxxx

# ---------- Email — Opzione A: SMTP (consigliata) ----------
# Usa qualsiasi mailer (Gmail, Outlook, Mailgun, SendGrid...).
# Per Gmail serve una "App password" da https://myaccount.google.com/apppasswords
# (l'autenticazione a 2 fattori deve essere attiva).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tuonome@gmail.com
SMTP_PASS=tua_app_password_a_16_caratteri
SMTP_FROM=NETMED <noreply@netmed.it>

# ---------- Email — Opzione B: Google Apps Script (alternativa) ----------
# Lascia vuoto se usi SMTP. Se vuoi usare Apps Script invece di SMTP,
# riempili e svuota le SMTP_*.
APPS_SCRIPT_EMAIL_URL=
APPS_SCRIPT_EMAIL_SECRET=
